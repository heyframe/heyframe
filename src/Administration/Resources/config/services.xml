<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Administration\Framework\Twig\ViteFileAccessorDecorator" decorates="pentatrion_vite.file_accessor">
            <argument>%pentatrion_vite.configs%</argument>
            <argument type="service" id="heyframe.asset.asset"/>
            <argument type="service" id="kernel"/>
            <argument type="service" id="filesystem"/>
        </service>
    </services>
</container>