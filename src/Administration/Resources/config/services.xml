<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>
        <parameter key="env(HEYFRAME_ADMINISTRATION_PATH_NAME)">admin</parameter>
        <parameter key="heyframe_administration.path_name">%env(resolve:HEYFRAME_ADMINISTRATION_PATH_NAME)%</parameter>
    </parameters>

    <services>
        <service id="HeyFrame\Administration\Framework\Routing\AdministrationRouteScope">
            <argument>%heyframe_administration.path_name%</argument>
            <tag name="heyframe.route_scope"/>
        </service>

        <service id="HeyFrame\Administration\Framework\Twig\ViteFileAccessorDecorator" decorates="pentatrion_vite.file_accessor">
            <argument>%pentatrion_vite.configs%</argument>
            <argument type="service" id="heyframe.asset.asset"/>
            <argument type="service" id="kernel"/>
            <argument type="service" id="filesystem"/>
        </service>

        <service id="HeyFrame\Administration\Controller\UserConfigController" public="true">
            <argument type="service" id="user_config.repository"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>


        <service id="HeyFrame\Administration\Service\AdminSearcher">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
        </service>

        <service id="HeyFrame\Administration\Controller\AdminSearchController" public="true">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Search\RequestCriteriaBuilder"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="HeyFrame\Administration\Service\AdminSearcher"/>
            <argument type="service" id="serializer"/>
            <argument type="service" id="HeyFrame\Core\Framework\Api\Acl\Admin\AclCriteriaValidator"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="HeyFrame\Core\Framework\Api\Serializer\JsonEntityEncoder"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="HeyFrame\Administration\Snippet\SnippetFinder">
            <argument type="service" id="kernel" />
            <argument type="service" id="heyframe.filesystem.private"/>
            <argument type="service" id="HeyFrame\Core\System\Snippet\Struct\TranslationConfig"/>
            <argument type="service" id="HeyFrame\Core\System\Snippet\Service\TranslationLoader"/>
        </service>

        <service id="HeyFrame\Administration\Snippet\CachedSnippetFinder" decorates="HeyFrame\Administration\Snippet\SnippetFinder">
            <argument type="service" id="HeyFrame\Administration\Snippet\CachedSnippetFinder.inner" />
            <argument type="service" id="cache.object" />
        </service>

        <service id="HeyFrame\Administration\Framework\Routing\KnownIps\KnownIpsCollector"/>

        <service id="HeyFrame\Administration\Controller\AdministrationController" public="true">
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Twig\TemplateFinder"/>
            <argument type="service" id="HeyFrame\Core\Framework\Store\Services\FirstRunWizardService"/>
            <argument type="service" id="HeyFrame\Administration\Snippet\SnippetFinder"/>
            <argument>%kernel.supported_api_versions%</argument>
            <argument type="service" id="HeyFrame\Administration\Framework\Routing\KnownIps\KnownIpsCollector"/>
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="currency.repository"/>
            <argument type="service" id="HeyFrame\Core\Framework\Util\HtmlSanitizer"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="HeyFrame\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="heyframe.filesystem.asset"/>
            <argument type="string">%heyframe.api.refresh_token_ttl%</argument>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="HeyFrame\Administration\System\Channel\Subscriber\ChannelUserConfigSubscriber">
            <argument type="service" id="user_config.repository" />
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
