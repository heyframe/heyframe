{% block sw_channel_detail_hreflang %}
<mt-card
    :title="$tc('sw-channel.detail.hreflang.title')"
    class="sw-channel-detail-hreflang"
    position-identifier="sw-channel-detail-hreflang"
>
    {% block sw_channel_detail_hreflang_title %}
    <h4>
        <span class="sw-channel-detail-domains__headline-text sw-channel-detail-base__headline-text">{{ $tc('sw-channel.detail.hreflang.titleCard') }}</span>
    </h4>
    {% endblock %}

    {% block sw_channel_detail_hreflang_content %}
    {% block sw_channel_detail_hreflang_content_description %}
    <div class="sw-channel-detail-base__description-text">
        {{ $tc('sw-channel.detail.hreflang.titleDescription') }}
    </div>
    {% endblock %}

    {% block sw_channel_detail_hreflang_content_enable %}

    <mt-switch
        v-model="channel.hreflangActive"
        :label="$tc('sw-channel.detail.hreflang.enableCheckbox')"
        :disabled="disabled || undefined"
        @update:model-value="channel.hreflangDefaultDomainId = null"
    />
    {% endblock %}

    {% block sw_channel_detail_hreflang_content_domain %}
    <sw-entity-single-select
        v-model:value="channel.hreflangDefaultDomainId"
        :disabled="!channel.hreflangActive || disabled || undefined"
        :label="$tc('sw-channel.detail.hreflang.defaultDomain')"
        entity="channel_domain"
        :criteria="domainCriteria"
        label-property="url"
        show-clearable-button
    />
    {% endblock %}

    {% endblock %}
</mt-card>
{% endblock %}
