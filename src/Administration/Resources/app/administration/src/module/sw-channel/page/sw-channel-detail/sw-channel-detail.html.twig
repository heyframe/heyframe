{% block sw_channel_detail %}
<sw-page class="sw-channel-detail">
    {% block sw_channel_detail_header %}
    <template #smart-bar-header>
        {% block sw_channel_detail_header_headline %}
        <h2>{{ placeholder(channel, 'name', $tc('sw-channel.detail.textHeadline')) }}</h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_channel_detail_actions %}
    <template #smart-bar-actions>
        {% block sw_channel_detail_actions_save %}
        <sw-button-process
            v-tooltip.bottom="tooltipSave"
            class="sw-channel-detail__save-action"
            :is-loading="isLoading"
            :process-success="isSaveSuccessful"
            :disabled="!allowSaving || isLoading"
            variant="primary"
            @update:process-success="saveFinish"
            @click.prevent="onSave"
        >
            {{ $tc('sw-channel.detail.buttonSave') }}
        </sw-button-process>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_channel_detail_language_switch %}
    <template #language-switch>
        <sw-language-switch
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            @on-change="onChangeLanguage"
        />
    </template>
    {% endblock %}

    {% block sw_channel_detail_content %}
    <template #content>
        <sw-card-view>

            {% block sw_channel_detail_content_language_info %}
            <sw-language-info
                :entity-description="placeholder(channel, 'name', $tc('sw-channel.detail.textHeadline'))"
            />
            {% endblock %}

            {% block sw_channel_detail_content_tabs %}
            <sw-tabs
                class="sw-channel-detail-__tabs"
                position-identifier="sw-channel-detail"
            >
                {%  block sw_channel_detail_content_tab_general %}
                <sw-tabs-item
                    :route="{ name: 'sw.channel.detail.base', params: { id: $route.params.id } }"
                    :title="$tc('sw-channel.detail.tabBase')"
                >
                    {{ $tc('sw-channel.detail.tabBase') }}
                </sw-tabs-item>
                {% endblock %}

                {% block sw_channel_detail_content_tab_products %}
                <sw-tabs-item
                    v-if="isHeadless || isStorefront"
                    :route="{ name: 'sw.channel.detail.products', params: { id: $route.params.id } }"
                    :title="$tc('sw-channel.detail.tabProducts')"
                >
                    {{ $tc('sw-channel.detail.tabProducts') }}
                </sw-tabs-item>
                {% endblock %}

                {% block sw_channel_detail_content_tab_theme %}{% endblock %}

            </sw-tabs>
            {% endblock %}

            {% block sw_channel_detail_content_view %}
            <template v-if="isLoading">
                <sw-skeleton />
                <sw-skeleton />
            </template>

            <template v-else>
                <router-view
                    :key="$route.params.id"
                    v-slot="{ Component }"
                >
                    <component
                        :is="Component"
                        :channel="channel"
                        :frontend-channel-criteria="frontendChannelCriteria"
                        :custom-field-sets="customFieldSets"
                        :is-loading="isLoading"
                    />
                </router-view>
            </template>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}

    <template #sidebar>
        {% block sw_channel_detail_sidebar %}
        {% endblock %}
    </template>
</sw-page>
{% endblock %}
