{% block sw_navigation_seo_form %}
<div class="sw-navigation-seo-form">
    {% block sw_navigation_seo_form_meta_title %}

    <mt-text-field
        v-model="navigation.metaTitle"
        maxlength="255"
        :disabled="!acl.can('navigation.editor')"
        :label="$tc('sw-navigation.base.seo.labelMetaTitle')"
        :help-text="$tc('sw-landing-page.base.seo.helpTextMetaTitle')"
        :placeholder="$tc('sw-navigation.base.seo.placeholderMetaTitle')"
    />
    {% endblock %}

    {% block sw_navigation_seo_form_meta_description %}
    <mt-textarea
        v-model="navigation.metaDescription"
        maxlength="255"
        :disabled="!acl.can('navigation.editor')"
        :label="$tc('sw-navigation.base.seo.labelMetaDescription')"
        :help-text="$tc('sw-landing-page.base.seo.helpTextMetaDescription')"
        :placeholder="$tc('sw-navigation.base.seo.placeholderMetaDescription')"
    />
    {% endblock %}

    {% block sw_navigation_seo_form_keywords %}

    <mt-text-field
        v-model="navigation.keywords"
        :disabled="!acl.can('navigation.editor')"
        :label="$tc('sw-navigation.base.seo.labelKeywords')"
        :placeholder="$tc('sw-navigation.base.seo.placeholderKeywords')"
    />
    {% endblock %}
</div>
{% endblock %}
