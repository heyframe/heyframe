{% block sw_navigation_entry_point_card %}
<mt-card
    class="sw-navigation-entry-point-card"
    position-identifier="sw-navigation-entry-point"
    :title="$tc('sw-navigation.base.entry-point-card.cardTitle')"
>

    {% block sw_navigation_entry_point_card_selection %}
    <sw-single-select
        v-model:value="selectedEntryPoint"
        class="sw-navigation-entry-point-card__entry-point-selection"
        :options="entryPoints"
        :label="$tc('sw-navigation.base.entry-point-card.labelEntryPoint')"
        :placeholder="$tc('sw-navigation.base.entry-point-card.placeholderEntryPoint')"
        :help-text="helpText"
        :disabled="hasExistingNavigation || !acl.can('navigation.editor')"
        show-clearable-button
        @update:value="onEntryPointChange"
    />
    {% endblock %}

    {% block sw_navigation_entry_point_card_navigation_headline %}
    <p v-if="hasExistingNavigation">
        {{ $tc('sw-navigation.base.entry-point-card.existingNavigationDescription') }}
    </p>
    {% endblock %}

    {% block sw_navigation_entry_point_card_navigation_list %}
    <div
        v-if="hasExistingNavigation"
        class="sw-navigation-entry-point-card__navigation-list"
    >

        {% block sw_navigation_detail_entry_point_navigation_list_link %}
        <router-link
            v-for="Channel in initialNavigationChannels"
            :key="Channel.id"
            :to="{ name: 'sw.sales.channel.detail.base', params: { id: Channel.id }}"
            class="sw-navigation-entry-point-card__navigation-entry"
        >
            {{ Channel.translated.name }}
        </router-link>
        {% endblock %}

    </div>
    {% endblock %}

    {% block sw_navigation_entry_point_card_channel_selection %}
    <sw-navigation-channel-multi-select
        v-if="associatedCollection"
        class="sw-navigation-entry-point-card__channel-selection"
        :entity-collection="associatedCollection"
        :label="ChannelSelectionLabel"
        :criteria="ChannelCriteria"
        :placeholder="$tc('sw-navigation.base.entry-point-card.placeholderChannels')"
        :disabled="!selectedEntryPoint || !acl.can('navigation.editor')"
        @update:entity-collection="onChannelChange"
    />
    {% endblock %}

    {% block sw_navigation_entry_point_card_button_configure_home %}
    <mt-button
        v-if="selectedEntryPoint === 'navigationChannels' && navigation.navigationChannels.length > 0"
        class="sw-navigation-entry-point-card__button-configure-home"
        ghost
        size="small"
        variant="secondary"
        @click="openConfigureHomeModal"
    >
        {{ $tc('sw-navigation.base.entry-point-card.buttonConfigureHome') }}
    </mt-button>
    {% endblock %}

    {% block sw_navigation_entry_point_card_configure_home_modal %}
    <sw-navigation-entry-point-modal
        v-if="configureHomeModalVisible"
        :channel-collection="navigation.navigationChannels"
        @modal-close="closeConfigureHomeModal"
    />
    {% endblock %}
</mt-card>
{% endblock %}
