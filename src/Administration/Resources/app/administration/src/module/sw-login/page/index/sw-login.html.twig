{% block sw_login %}
<div
    v-show="shouldRenderDOM"
    class="sw-login"
    :class="{ 'is--login-success' : isLoginSuccess }"
>

    {% block sw_login_container %}
    <div
        class="sw-login__container"
        :class="{ 'is--login-error': isLoginError }"
    >
        {% block sw_login_image %}
        <img class="sw-login__image"
                :src="assetFilter('/administration/administration/static/img/sw-login-background.png')"
            >
        {% endblock %}

        {% block sw_login_form %}
        <div class="sw-login__content">
            {% block sw_login_view %}

            <router-view
                v-slot="{Component}"
            >
                <transition
                    name="fade"
                    mode="out-in"
                >
                    <component
                        :is="Component"
                        :hash="hash"
                        @is-loading="setLoading(true)"
                        @is-not-loading="setLoading(false)"
                        @login-error="loginError"
                        @login-success="loginSuccess"
                    />
                </transition>
            </router-view>
            {% endblock %}

            {% block sw_login_loader %}
            <sw-loader v-if="isLoading" />
            {% endblock %}
        </div>
        {% endblock %}
    </div>
    {% endblock %}
    {% block sw_login_footer %}
    <footer class="sw-login__footer">
        <div class="sw-login__footer-headline">
            &copy; Copyright 2025. HeyFarme all rights reserved.
        </div>
    </footer>
    {% endblock %}
</div>
{% endblock %}
