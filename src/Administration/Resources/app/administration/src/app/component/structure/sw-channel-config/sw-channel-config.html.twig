{% block sw_channel_config %}
<div
    class="sw-channel-config"
    @channelChanged="save"
>
    <div class="sw-channel-config__global-channel-switch">
        {% block sw_channel_config_switch %}
        <slot
            name="select"
            v-bind="{ onInput, selectedChannelId, channel }"
        >
            <sw-single-select
                v-model:value="selectedChannelId"
                :options="channel"
                label-property="translated.name"
                value-property="id"
                show-clearable-button
                @update:value="onInput"
            />
        </slot>
        {% endblock %}
    </div>

    <slot
        name="content"
        v-bind="{ actualConfigData, allConfigs, selectedChannelId }"
    ></slot>
</div>
{% endblock %}
