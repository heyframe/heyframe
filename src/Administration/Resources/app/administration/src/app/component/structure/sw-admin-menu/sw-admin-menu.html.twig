<aside class="sw-admin-menu">
    <div class="sw-admin-menu__header">
        <div>
            <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="36" height="36" rx="4" fill="#315CFD"/>
                <path fill-rule="evenodd" clip-rule="evenodd"
                      d="M17.7856 8.60923C18.073 8.46359 18.427 8.46359 18.7143 8.60923L27.0356 12.8266C27.3229 12.9722 27.5 13.2414 27.5 13.5327V21.9673C27.5 22.2587 27.3229 22.5278 27.0356 22.6734L18.7143 26.8908C18.427 27.0364 18.073 27.0364 17.7856 26.8908L9.46439 22.6734C9.17703 22.5278 9 22.2587 9 21.9673V13.5327C9 13.2414 9.17703 12.9722 9.46439 12.8266L17.7856 8.60923ZM11.8548 13.5836L18.25 10.3424L24.6452 13.5835L18.2499 16.7699L11.8548 13.5836ZM10.942 15.089V21.4538L17.2789 24.6655V18.2463L10.942 15.089ZM19.2209 24.6655L25.558 21.4538V15.0889L19.2209 18.2463V24.6655Z"
                      fill="white"/>
            </svg>
        </div>

        <div>
            <mt-text weight="bold" size="xs">Acme Inc</mt-text>
            <mt-text size="2xs" color="color-text-secondary-default">Shopware Beyond</mt-text>
        </div>
    </div>

    <div class="sw-admin-menu__navigation">
        <RovingFocusGroup as="div">
            <ul class="sw-admin-menu__modules">
                <li
                    v-for="module in MODULES"
                    :key="module.id">
                    <RovingFocusItem as-child>
                        <router-link
                            :to="{ name: module.to }"
                            class="sw-admin-menu__nav-item"
                            :class="{
                            'router-link-active': module.match($route) === 'exact'
                        }">

                            <mt-icon
                                size="var(--scale-size-16)"
                                :name="`${module.match($route) === 'exact' || (!!module.children && module.children.some(subModule => subModule.match($route) !== 'none')) ? 'solid' : 'regular'}-${module.icon}`"
                                :color="module.match($route) === 'exact' ? 'var(--color-icon-brand-default)' : '#696A6E'"
                            />

                            <span>{{ module.name }}</span>
                        </router-link>
                    </RovingFocusItem>

                    <ul v-if="module.hasOwnProperty('children') && (module.match($route) !== 'none' || !!module.children && module.children.some(subModule => subModule.match($route) !== 'none'))"
                        style="position: relative; list-style: none">
                        <div
                            style="position: absolute; width: 1px; background: var(--color-border-primary-default); height: calc(100% - 5px * 2); top: 50%; transform: translateY(-50%); left: 17.5px"></div>

                        <li v-for="subModule in module.children"
                            :key="subModule.id">
                            <RovingFocusItem as-child>
                                <router-link
                                    class="sw-admin-menu__nav-item"
                                    :class="{
                                        'router-link-active': subModule.match($route) === 'exact'
                                    }"
                                    :to="{ name: subModule.to }">
                                    <div
                                        style="display: grid; place-items: center; width: var(--scale-size-16); height: var(--scale-size-26);">
                                        <MotionDiv :transition="{ type: 'spring', duration: 0.2, bounce: 0}"
                                                   layoutId="some-element" v-if="subModule.match($route) === 'exact'"
                                                   style="width: 9px; background: var(--color-border-brand-selected); border-radius: 999px; height: 100%; z-index: 1; border: 3px solid var(--admin-menu-item-background-selected)"></MotionDiv>
                                    </div>

                                    <span>{{ subModule.name }}</span>
                                </router-link>
                            </RovingFocusItem>
                        </li>
                    </ul>
                </li>
            </ul>
        </RovingFocusGroup>

        <div>
            <mt-text weight="medium"
                     size="xs"
                     color="color-text-secondary-default"
                     class="sw-admin-menu__sales-channel-heading"
            >
                Channel
            </mt-text>

            <RovingFocusGroup as="ul" class="sw-admin-menu__sales-channel-list">
                <li v-for="channel in channels"
                    :key="channel.id">
                    <RovingFocusItem as-child>
                        <router-link
                            class="sw-admin-menu__sales-channel"
                            :class="{
                            'router-link-active': isChannelSelected(channel.id)
                        }"
                            :to="{
                            name: 'sw.channel.detail',
                            params: { id: channel.id }
                        }">

                            <mt-icon
                                size="var(--scale-size-16)"
                                :name="`${isChannelSelected(channel.id) ? 'solid' : 'regular'}-dashboard`"
                                :color="isChannelSelected(channel.id) ? 'var(--color-icon-brand-default)' : '#696A6E'"
                            />

                            <span>{{ channel.translated.name }}</span>
                        </router-link>
                    </RovingFocusItem>
                </li>
            </RovingFocusGroup>
        </div>
    </div>


    <div class="sw-admin-menu__dark-mode-section">
        <mt-switch v-model="isDarkMode" label="Dark mode"/>

        <span class="sw-admin-menu__dark-mode-experimental-badge">
            Experimental
        </span>
    </div>

    <div>
        <PopoverRoot :open="showAccountMenu" @update:open="showAccountMenu = $event">
            <div style="margin-inline-start: -8px">
                <PopoverTrigger class="sw-admin-menu__account">
                    <div class="sw-admin-menu__avatar">
                        <span>GXS</span>
                    </div>

                    <div>
                        <mt-text size="xs" weight="semibold">Jennifer Johnson</mt-text>
                        <mt-text size="2xs">j.johnson@example.com</mt-text>
                    </div>

                    <div class="sw-admin-menu__account-arrows" aria-hidden="true">
                        <mt-icon name="regular-chevron-up-xxs" color="var(--color-icon-primary-default)"/>
                        <mt-icon name="regular-chevron-down-xxs" color="var(--color-icon-primary-default)"/>
                    </div>
                </PopoverTrigger>
            </div>

            <PopoverPortal>
                <PopoverContent :side-offset="8" side="top" class="sw-admin-menu__account-menu">
                    <div class="sw-admin-menu__account-menu-item-list">
                        <router-link @click="showAccountMenu = false" :to="{ name: 'sw.profile.index' }"
                                     :data-variant="$route.name.startsWith('sw.profile') ? 'selected' : 'primary'"
                                     class="sw-admin-menu__account-menu-item" href="/bar">
                            <mt-icon
                                :name="`${$route.name.startsWith('sw.profile') ? 'solid' : 'regular'}-user`"
                                :color="$route.name.startsWith('sw.profile') ? 'var(--color-icon-brand-default)' : 'var(--color-icon-primary-default)'"
                                size="14px"
                            />

                            <span>Profile settings</span>
                        </router-link>

                        <button class="sw-admin-menu__account-menu-item" data-variant="critical" @click="signOut">
                            <mt-icon
                                name="regular-sign-out"
                                color="var(--color-icon-critical-default)"
                                size="14px"
                            />

                            <span>Sign out</span>
                        </button>
                    </div>

                    <div class="sw-admin-menu__account-menu-footer">
                        <mt-text
                            size="2xs"
                            color="color-text-secondary-default">
                            Version: 6.7.1
                        </mt-text>
                    </div>
                </PopoverContent>
            </PopoverPortal>
        </PopoverRoot>
    </div>
</aside>
