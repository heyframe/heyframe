<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>

        <service id="HeyFrame\Core\Checkout\Points\PointsDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Checkout\Points\Aggregate\PointsLog\PointsLogDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Checkout\Points\Subscriber\CustomerSubscriber">
            <argument type="service" id="points.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>

    </services>
</container>
