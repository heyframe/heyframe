<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Core\Content\Flow\FlowDefinition">
            <tag name="heyframe.entity.definition" />
        </service>

        <service id="HeyFrame\Core\Content\Flow\Aggregate\FlowSequence\FlowSequenceDefinition">
            <tag name="heyframe.entity.definition" />
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\FlowDispatcher" decorates="event_dispatcher" decoration-priority="1000">
            <argument type="service" id="HeyFrame\Core\Content\Flow\Dispatching\FlowDispatcher.inner"/>
            <argument type="service_locator">
                <argument type="service" key="logger" id="logger"/>
                <argument type="service" key="Doctrine\DBAL\Connection" id="Doctrine\DBAL\Connection"/>
                <argument type="service" key="HeyFrame\Core\Content\Flow\Dispatching\FlowFactory" id="HeyFrame\Core\Content\Flow\Dispatching\FlowFactory"/>
                <argument type="service" key="HeyFrame\Core\Content\Flow\Dispatching\FlowExecutor" id="HeyFrame\Core\Content\Flow\Dispatching\FlowExecutor"/>
                <argument type="service" key="HeyFrame\Core\Content\Flow\Dispatching\FlowLoader" id="HeyFrame\Core\Content\Flow\Dispatching\FlowLoader"/>
                <argument type="service" key="HeyFrame\Core\Content\Flow\Dispatching\BufferedFlowQueue" id="HeyFrame\Core\Content\Flow\Dispatching\BufferedFlowQueue"/>
            </argument>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\BufferedFlowQueue" />

        <service id="HeyFrame\Core\Content\Flow\Dispatching\BufferedFlowExecutor">
            <argument type="service" id="HeyFrame\Core\Content\Flow\Dispatching\BufferedFlowQueue"/>
            <argument type="service" id="HeyFrame\Core\Content\Flow\Dispatching\FlowLoader"/>
            <argument type="service" id="HeyFrame\Core\Content\Flow\Dispatching\FlowFactory"/>
            <argument type="service" id="HeyFrame\Core\Content\Flow\Dispatching\FlowExecutor"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\BufferedFlowExecutionTriggersListener">
            <argument type="service_locator">
                <argument type="service" key="HeyFrame\Core\Content\Flow\Dispatching\BufferedFlowExecutor" id="HeyFrame\Core\Content\Flow\Dispatching\BufferedFlowExecutor"/>
            </argument>
            <argument type="service" id="HeyFrame\Core\Content\Flow\Dispatching\BufferedFlowQueue"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Rule\FlowRuleScopeBuilder">
            <argument type="service" id="HeyFrame\Core\Checkout\Cart\Order\OrderConverter"/>
            <argument type="tagged_iterator" tag="heyframe.cart.collector"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\FlowExecutor" public="true">
            <argument type="service" id="HeyFrame\Core\Checkout\Cart\RuleLoader"/>
            <argument type="service" id="HeyFrame\Core\Content\Flow\Rule\FlowRuleScopeBuilder"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Framework\Extensions\ExtensionDispatcher"/>
            <argument type="service" id="logger"/>
            <argument type="tagged_iterator" tag="flow.action" index-by="key" />
        </service>


        <service id="HeyFrame\Core\Content\Flow\Dispatching\Action\ChangeCustomerGroupAction">
            <argument type="service" id="customer.repository" />
            <tag name="flow.action" priority="690" key="action.change.customer.group"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Action\ChangeCustomerStatusAction">
            <argument type="service" id="customer.repository" />
            <tag name="flow.action" priority="680" key="action.change.customer.status"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Action\SetOrderStateAction">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Checkout\Order\Channel\OrderService"/>
            <tag name="flow.action" priority="400" key="action.set.order.state" />
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Action\SetCustomerCustomFieldAction">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="customer.repository" />
            <tag name="flow.action" priority="350" key="action.set.customer.custom.field"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Action\SetOrderCustomFieldAction">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="order.repository" />
            <tag name="flow.action" priority="300" key="action.set.order.custom.field"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Action\SetCustomerGroupCustomFieldAction">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="customer_group.repository" />
            <tag name="flow.action" priority="350" key="action.set.customer.group.custom.field"/>
        </service>

       <service id="HeyFrame\Core\Content\Flow\Dispatching\Action\AddCustomerTagAction">
            <argument type="service" id="customer.repository" />
            <tag name="flow.action" priority="900" key="action.add.customer.tag"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Action\AddOrderTagAction">
            <argument type="service" id="order.repository" />
            <tag name="flow.action" priority="1000" key="action.add.order.tag" />
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Action\StopFlowAction">
            <tag name="flow.action" priority="1" key="action.stop.flow" />
        </service>

        <service id="HeyFrame\Core\Content\Flow\Api\FlowActionCollector">
            <argument type="tagged_iterator" tag="flow.action" />
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\FlowLoader" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\CachedFlowLoader" decorates="HeyFrame\Core\Content\Flow\Dispatching\FlowLoader" decoration-priority="-1000" public="true">
            <argument type="service" id="HeyFrame\Core\Content\Flow\Dispatching\CachedFlowLoader.inner"/>
            <argument type="service" id="cache.object"/>

            <tag name="kernel.event_subscriber" />
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Indexing\FlowPayloadUpdater">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Content\Flow\Dispatching\FlowBuilder"/>
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Cache\CacheInvalidator"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Indexing\FlowIndexer">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Dbal\Common\IteratorFactory"/>
            <argument type="service" id="flow.repository"/>
            <argument type="service" id="HeyFrame\Core\Content\Flow\Indexing\FlowPayloadUpdater"/>
            <argument type="service" id="event_dispatcher"/>

            <tag name="heyframe.entity_indexer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Indexing\FlowIndexerSubscriber">
            <argument type="service" id="messenger.default_bus"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\FlowBuilder"/>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\OrderStorer">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="event_dispatcher"/>

            <tag name="flow.storer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\ProductStorer">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="event_dispatcher"/>

            <tag name="flow.storer"/>
        </service>


        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\CustomerStorer">
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="event_dispatcher"/>

            <tag name="flow.storer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\UserStorer">
            <argument type="service" id="user_recovery.repository"/>
            <argument type="service" id="event_dispatcher"/>

            <tag name="flow.storer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\CustomerGroupStorer">
            <argument type="service" id="customer_group.repository"/>
            <argument type="service" id="event_dispatcher"/>

            <tag name="flow.storer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\OrderTransactionStorer">
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="event_dispatcher"/>

            <tag name="flow.storer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\ScalarValuesStorer">
            <tag name="flow.storer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\MessageStorer">
            <tag name="flow.storer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\CustomAppStorer">
            <tag name="flow.storer" priority="999"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\LanguageStorer">
            <tag name="flow.storer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\Storer\TimezoneStorer">
            <argument type="service" id="Symfony\Component\HttpFoundation\RequestStack"/>

            <tag name="flow.storer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Dispatching\FlowFactory" public="true">
            <argument type="tagged_iterator" tag="flow.storer"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Rule\OrderTagRule">
            <tag name="heyframe.rule.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Rule\OrderCreatedByAdminRule">
            <tag name="heyframe.rule.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Rule\OrderTransactionStatusRule">
            <tag name="heyframe.rule.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Rule\OrderStatusRule">
            <tag name="heyframe.rule.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Rule\OrderCustomFieldRule">
            <tag name="heyframe.rule.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Flow\Aggregate\FlowTemplate\FlowTemplateDefinition">
            <tag name="heyframe.entity.definition" />
        </service>

        <service id="HeyFrame\Core\Content\Flow\DataAbstractionLayer\FieldSerializer\FlowTemplateConfigFieldSerializer">
            <argument type="service" id="validator" />
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry" />
            <tag name="heyframe.field_serializer"/>
        </service>
    </services>
</container>
