<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Core\Content\Cookie\Service\CookieProvider">
            <argument type="service" id="Symfony\Contracts\EventDispatcher\EventDispatcherInterface"/>
            <argument type="service" id="translator"/>
            <argument>%session.storage.options%</argument>
        </service>

        <service id="HeyFrame\Core\Content\Cookie\Channel\CookieRoute" public="true">
            <argument type="service" id="HeyFrame\Core\Content\Cookie\Service\CookieProvider"/>
        </service>
    </services>
</container>
