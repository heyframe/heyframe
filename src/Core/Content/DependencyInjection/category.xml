<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Core\Content\Category\CategoryDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Category\Aggregate\CategoryTranslation\CategoryTranslationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Category\Aggregate\CategoryTag\CategoryTagDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Category\Service\DefaultCategoryLevelLoader">
            <argument type="service" id="category.repository"/>
        </service>

        <service id="HeyFrame\Core\Content\Category\Service\CachedDefaultCategoryLevelLoader" decorates="HeyFrame\Core\Content\Category\Service\DefaultCategoryLevelLoader">
            <argument type="service" id="cache.object"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="HeyFrame\Core\Content\Category\Service\CachedDefaultCategoryLevelLoader.inner"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Category\Tree\CategoryTreePathResolver"/>


<!--        <service id="HeyFrame\Core\Content\Category\Channel\CategoryRoute" public="true">-->
<!--            <argument type="service" id="channel.category.repository"/>-->
<!--            <argument type="service" id="HeyFrame\Core\Content\Cms\Channel\ChannelCmsPageLoader"/>-->
<!--            <argument type="service" id="HeyFrame\Core\Content\Category\Channel\ChannelCategoryDefinition"/>-->
<!--            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Cache\CacheTagCollector"/>-->
<!--        </service>-->

        <service id="HeyFrame\Core\Content\Category\Channel\CategoryListRoute" public="true">
            <argument type="service" id="category.repository"/>
        </service>

        <service id="HeyFrame\Core\Content\Category\DataAbstractionLayer\CategoryIndexer">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Dbal\Common\IteratorFactory"/>
            <argument type="service" id="category.repository"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\ChildCountUpdater"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\TreeUpdater"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="heyframe.entity_indexer"/>
        </service>


        <service id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\TreeUpdater">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyFrame\Core\Content\Category\Service\CategoryUrlGenerator"/>

        <service id="HeyFrame\Core\Content\Category\Subscriber\CategorySubscriber">
            <argument type="service" id="HeyFrame\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="HeyFrame\Core\Content\Category\Service\CategoryUrlGenerator"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Category\Subscriber\CategoryTreeMovedSubscriber">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\EntityIndexerRegistry"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Category\DataAbstractionLayer\CategoryNonExistentExceptionHandler">
            <tag name="heyframe.dal.exception_handler"/>
        </service>
    </services>
</container>
