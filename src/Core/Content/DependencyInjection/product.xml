<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\ProductExceptionHandler">
            <tag name="heyframe.dal.exception_handler"/>
        </service>

       <service id="HeyFrame\Core\Content\Product\Channel\Sorting\ProductSortingDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Channel\Sorting\ProductSortingTranslationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\ProductDefinition">
            <tag name="heyframe.entity.definition"/>
            <tag name="heyframe.entity.hookable"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Channel\ChannelProductDefinition">
            <tag name="heyframe.channel.entity.definition"/>
        </service>

       <service id="HeyFrame\Core\Content\Product\Aggregate\ProductKeywordDictionary\ProductKeywordDictionaryDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductCategory\ProductCategoryDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductReview\ProductReviewDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductStreamMapping\ProductStreamMappingDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\SearchKeywordUpdater">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="language.repository"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\SearchKeyword\ProductSearchKeywordAnalyzer"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductCategoryTree\ProductCategoryTreeDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductCrossSelling\ProductCrossSellingDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductCrossSellingTranslation\ProductCrossSellingTranslationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductCrossSellingAssignedProducts\ProductCrossSellingAssignedProductsDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductConfiguratorSetting\ProductConfiguratorSettingDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductConfiguratorSetting\ProductConfiguratorSettingExceptionHandler">
            <tag name="heyframe.dal.exception_handler"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductPrice\ProductPriceDefinition">
            <tag name="heyframe.entity.definition"/>
            <tag name="heyframe.entity.hookable"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductProperty\ProductPropertyDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductMedia\ProductMediaDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductTranslation\ProductTranslationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductOption\ProductOptionDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductTag\ProductTagDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Cart\ProductGateway">
            <argument type="service" id="channel.product.repository"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\AbstractPropertyGroupSorter" class="HeyFrame\Core\Content\Product\PropertyGroupSorter"/>

        <service id="HeyFrame\Core\Content\Product\AbstractProductMaxPurchaseCalculator" class="HeyFrame\Core\Content\Product\ProductMaxPurchaseCalculator">
            <argument type="service" id="HeyFrame\Core\System\SystemConfig\SystemConfigService"/>
        </service>


        <service id="HeyFrame\Core\Content\Product\ProductVariationBuilder"/>

        <service id="HeyFrame\Core\Content\Product\Subscriber\ProductSubscriber">
            <argument type="service" id="HeyFrame\Core\Content\Product\ProductVariationBuilder"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\Channel\Price\ProductPriceCalculator"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\AbstractPropertyGroupSorter"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\AbstractProductMaxPurchaseCalculator"/>
            <argument type="service" id="HeyFrame\Core\System\SystemConfig\SystemConfigService"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Stock\OrderStockSubscriber">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\Stock\StockStorage"/>
            <argument>%heyframe.stock.enable_stock_management%</argument>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Stock\AvailableStockMirrorSubscriber">
            <tag name="kernel.event_listener"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Stock\LoadProductStockSubscriber">
            <argument type="service" id="HeyFrame\Core\Content\Product\Stock\StockStorage"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\SearchKeyword\ProductSearchKeywordAnalyzer">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Search\Term\Tokenizer"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Search\Term\Filter\TokenFilter"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Search\SearchConfigLoader"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Api\ProductActionController" public="true">
            <argument type="service" id="HeyFrame\Core\Content\Product\Util\VariantCombinationLoader"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductVisibility\ProductVisibilityDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Util\VariantCombinationLoader">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>


        <service id="HeyFrame\Core\Content\Product\Channel\Price\ProductPriceCalculator">
            <argument type="service" id="HeyFrame\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <argument type="service" id="HeyFrame\Core\Framework\Extensions\ExtensionDispatcher"/>

            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Channel\Price\AppScriptProductPriceCalculator" decorates="HeyFrame\Core\Content\Product\Channel\Price\ProductPriceCalculator">
            <argument type="service" id="HeyFrame\Core\Content\Product\Channel\Price\AppScriptProductPriceCalculator.inner"/>
            <argument type="service" id="HeyFrame\Core\Framework\Script\Execution\ScriptExecutor"/>
            <argument type="service" id="HeyFrame\Core\Checkout\Cart\Facade\ScriptPriceStubs"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\SearchKeyword\ProductSearchBuilderInterface"
                 class="HeyFrame\Core\Content\Product\SearchKeyword\ProductSearchBuilder">
            <argument type="service" id="HeyFrame\Core\Content\Product\SearchKeyword\ProductSearchTermInterpreter"/>
            <argument type="service" id="logger"/>
            <argument>%heyframe.search.term_max_length%</argument>
        </service>

        <service id="HeyFrame\Core\Content\Product\Cart\ProductLineItemCommandValidator">
            <argument type="service" id="Doctrine\DBAL\Connection" />
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Channel\FindVariant\FindProductVariantRoute" public="true">
            <argument type="service" id="channel.product.repository"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\ProductCategoryDenormalizer">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

       <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\RatingAverageUpdater">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\ProductStreamUpdater">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\ProductDefinition"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="messenger.default_bus"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\ManyToManyIdFieldUpdater"/>
            <argument>%heyframe.product_stream.indexing%</argument>
            <tag name="heyframe.entity_indexer"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\StatesUpdater">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\ProductIndexer">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Dbal\Common\IteratorFactory"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\DataAbstractionLayer\VariantListingUpdater"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\DataAbstractionLayer\ProductCategoryDenormalizer"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\InheritanceUpdater"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\DataAbstractionLayer\RatingAverageUpdater"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\DataAbstractionLayer\SearchKeywordUpdater"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\ChildCountUpdater"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\ManyToManyIdFieldUpdater"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\Stock\StockStorage"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\DataAbstractionLayer\CheapestPriceUpdater"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\DataAbstractionLayer\ProductStreamUpdater"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\DataAbstractionLayer\StatesUpdater"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="heyframe.entity_indexer" priority="100"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Aggregate\ProductSearchKeyword\ProductSearchKeywordDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\VariantListingUpdater">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\CheapestPriceUpdater">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\DataAbstractionLayer\CheapestPriceQuantitySelector"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\CheapestPriceQuantitySelector"/>

        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\StockUpdate\StockUpdateFilterProvider">
            <argument type="tagged_iterator" tag="heyframe.product.stock_filter"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Stock\StockStorage">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Channel\Detail\ProductDetailRoute" public="true">
            <argument type="service" id="channel.product.repository"/>
            <argument type="service" id="HeyFrame\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\Channel\Detail\ProductConfiguratorLoader"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\Channel\ChannelProductDefinition"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\Channel\ProductCloseoutFilterFactory"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Cache\CacheTagCollector"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Channel\Detail\ProductConfiguratorLoader">
            <argument type="service" id="product_configurator_setting.repository"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\Channel\Detail\AvailableCombinationLoader"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Channel\Detail\AvailableCombinationLoader">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Content\Product\Stock\StockStorage"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Channel\ProductListRoute" public="true">
            <argument type="service" id="channel.product.repository"/>
        </service>


        <service id="HeyFrame\Core\Framework\DataAbstractionLayer\Search\Term\Filter\TokenFilter">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Search\SearchConfigLoader"/>

            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\DataAbstractionLayer\CheapestPrice\CheapestPriceAccessorBuilder">
            <argument>%heyframe.dal.max_rule_prices%</argument>
            <argument type="service" id="logger"/>

            <tag name="heyframe.field_accessor_builder" priority="-200"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Cleanup\CleanupProductKeywordDictionaryTask">
            <tag name="heyframe.scheduled.task"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Cleanup\CleanupProductKeywordDictionaryTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Cleanup\CleanupUnusedDownloadMediaTask">
            <tag name="heyframe.scheduled.task"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Cleanup\CleanupUnusedDownloadMediaTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="HeyFrame\Core\Content\Media\UnusedMediaPurger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="HeyFrame\Core\Content\Product\Channel\ProductCloseoutFilterFactory"/>

        <service id="HeyFrame\Core\Content\Product\Api\ProductNumberFkResolver">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="heyframe.sync.fk_resolver"/>
        </service>
    </services>
</container>
