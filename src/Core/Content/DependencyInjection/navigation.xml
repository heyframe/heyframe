<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Core\Content\Navigation\NavigationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Navigation\Aggregate\NavigationTranslation\NavigationTranslationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Navigation\Validation\EntryPointValidator">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Navigation\Channel\ChannelNavigationDefinition">
            <tag name="heyframe.channel.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Navigation\DataAbstractionLayer\NavigationIndexer">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Dbal\Common\IteratorFactory"/>
            <argument type="service" id="navigation.repository"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\ChildCountUpdater"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\TreeUpdater"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="heyframe.entity_indexer"/>
        </service>

        <service id="HeyFrame\Core\Content\Navigation\Service\NavigationBreadcrumbBuilder">
        </service>

        <service id="HeyFrame\Core\Content\Navigation\Service\NavigationUrlGenerator">
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlPlaceholderHandlerInterface" />
        </service>

        <service id="HeyFrame\Core\Content\Navigation\Channel\LoadNavigationRoute" public="true">
            <argument type="service" id="navigation.repository"/>
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Cache\CacheTagCollector"/>
        </service>

        <service id="HeyFrame\Core\Content\Navigation\Tree\NavigationTreePathResolver"/>

        <service id="HeyFrame\Core\Content\Navigation\Service\DefaultNavigationLevelLoader">
            <argument type="service" id="navigation.repository"/>
        </service>
            <service id="HeyFrame\Core\Content\Navigation\Channel\NavigationRoute" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="category.repository"/>
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Cache\CacheTagCollector"/>
            <argument type="service" id="HeyFrame\Core\Content\Navigation\Tree\NavigationTreePathResolver"/>
            <argument type="service" id="HeyFrame\Core\Content\Navigation\Service\DefaultNavigationLevelLoader"/>
        </service>

        <service id="HeyFrame\Core\Content\Navigation\Service\NavigationLoader">
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="HeyFrame\Core\Content\Navigation\Channel\NavigationRoute"/>
        </service>
    </services>
</container>
