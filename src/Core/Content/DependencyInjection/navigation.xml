<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Core\Content\Navigation\NavigationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Navigation\Aggregate\NavigationTranslation\NavigationTranslationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Navigation\DataAbstractionLayer\NavigationIndexer">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Dbal\Common\IteratorFactory"/>
            <argument type="service" id="navigation.repository"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\ChildCountUpdater"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\TreeUpdater"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="heyframe.entity_indexer"/>
        </service>

    </services>
</container>
