<!--            <argument type="service" id="channel.landing_page.repository"/>-->
<!--            <argument type="service" id="HeyFrame\Core\Content\Cms\Channel\ChannelCmsPageLoader"/>-->
<!--            <argument type="service" id="HeyFrame\Core\Content\LandingPage\Channel\ChannelLandingPageDefinition"/>-->
<!--            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Cache\CacheTagCollector"/>-->
<!--        </service>-->

        <service id="HeyFrame\Core\Content\LandingPage\LandingPageValidator">
            <argument type="service" id="validator"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
