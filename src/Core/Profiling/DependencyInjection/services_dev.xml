<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="HeyFrame\Core\Profiling\Controller\ProfilerController">
            <argument type="service" id="twig" />
            <argument type="service" id="profiler" />
            <argument type="service" id="Doctrine\DBAL\Connection" />

            <tag name="controller.service_arguments" />
        </service>

        <service id="HeyFrame\Core\Profiling\Routing\ProfilerWhitelist">
            <tag name="heyframe.route_scope_whitelist"/>
        </service>

        <service id="HeyFrame\Core\Profiling\Doctrine\ConnectionProfiler">
            <argument type="service" id="Doctrine\DBAL\Connection" />
            <tag name="data_collector"
                 template="@Profiling/Collector/db.html.twig"
                 id="app.connection_collector"
                 priority="200"
            />
        </service>

        <service id="HeyFrame\Core\Profiling\Twig\DoctrineExtension" public="false">
            <tag name="twig.extension" />
        </service>

        <service id="HeyFrame\Core\Profiling\Subscriber\ActiveRulesDataCollectorSubscriber">
            <argument type="service" id="rule.repository"/>

            <tag name="kernel.event_subscriber"/>
            <tag name="data_collector"/>
        </service>

        <service id="HeyFrame\Core\Profiling\FeatureFlag\FeatureFlagProfiler">
            <argument type="service" id="HeyFrame\Core\Framework\Feature\FeatureFlagRegistry"/>

            <tag name="data_collector" template="@Profiling/Collector/flags.html.twig" id="feature_flag" priority="-5" />
        </service>

        <service id="HeyFrame\Core\Profiling\Subscriber\CacheTagCollectorSubscriber">
            <tag name="kernel.event_subscriber"/>
            <tag name="data_collector"/>
            <argument type="service" id="request_stack"/>
        </service>

        <service id="HeyFrame\Core\Profiling\Subscriber\CartDataCollectorSubscriber">
            <argument type="service" id="HeyFrame\Core\Checkout\Cart\CartPersister"/>

            <tag name="kernel.event_subscriber"/>
            <tag name="data_collector"/>
        </service>
    </services>
</container>
