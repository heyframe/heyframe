<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Core\System\Dict\DictDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\System\Dict\Aggregate\DictTranslation\DictTranslationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\System\Dict\Aggregate\DictItem\DictItemDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\System\Dict\Aggregate\DictItemTranslation\DictItemTranslationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\System\Dict\DataAbstractionLayer\DictItemIndexer">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Dbal\Common\IteratorFactory"/>
            <argument type="service" id="dict_item.repository"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\ChildCountUpdater"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Indexing\TreeUpdater"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="messenger.default_bus"/>
            <tag name="heyframe.entity_indexer"/>
        </service>

        <service id="HeyFrame\Core\System\Dict\DictService" public="true" lazy="true">
            <argument type="service" id="HeyFrame\Core\System\Dict\DictLoader"/>
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Cache\CacheTagCollector"/>
        </service>

        <service id="HeyFrame\Core\System\Dict\DictLoader">
            <argument type="service" id="dict.repository"/>
        </service>

        <service id="HeyFrame\Core\System\Dict\CachedDictLoader" decorates="HeyFrame\Core\System\Dict\DictLoader" decoration-priority="-1000">
            <argument type="service" id="HeyFrame\Core\System\Dict\CachedDictLoader.inner"/>
            <argument type="service" id="cache.object"/>
        </service>
    </services>
</container>
