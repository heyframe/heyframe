<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Core\System\User\UserDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\System\User\Aggregate\UserConfig\UserConfigDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\System\User\Aggregate\UserAccessKey\UserAccessKeyDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\System\User\Service\UserValidationService">
            <argument type="service" id="user.repository"/>
        </service>

        <service id="HeyFrame\Core\System\User\Api\UserValidationController" public="true">
            <argument type="service" id="HeyFrame\Core\System\User\Service\UserValidationService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
