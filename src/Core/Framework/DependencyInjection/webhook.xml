<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="HeyFrame\Core\Framework\Webhook\WebhookDispatcher" decorates="event_dispatcher"
                 decoration-priority="100">
            <argument type="service" id="HeyFrame\Core\Framework\Webhook\WebhookDispatcher.inner"/>
            <argument type="service"  id="HeyFrame\Core\Framework\Webhook\Service\WebhookManager" />
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\Service\WebhookLoader">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service lazy="true" id="HeyFrame\Core\Framework\Webhook\Service\WebhookManager">
            <argument type="service" id="HeyFrame\Core\Framework\Webhook\Service\WebhookLoader"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Framework\Webhook\Hookable\HookableEventFactory"/>
            <argument type="service" id="HeyFrame\Core\Framework\App\AppLocaleProvider"/>
            <argument type="service" id="HeyFrame\Core\Framework\App\Payload\AppPayloadServiceHelper"/>
            <argument type="service" id="heyframe.app_system.guzzle"/>
            <argument type="service" id="Symfony\Component\Messenger\MessageBusInterface"/>
            <argument type="string">%env(APP_URL)%</argument>
            <argument>%kernel.heyframe_version%</argument>
            <argument>%heyframe.admin_worker.enable_admin_worker%</argument>
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\WebhookCacheClearer">
            <argument type="service" id="HeyFrame\Core\Framework\Webhook\Service\WebhookManager"/>

            <tag name="kernel.event_subscriber"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\Hookable\HookableEventFactory" lazy="true">
            <argument type="service" id="HeyFrame\Core\Framework\Webhook\BusinessEventEncoder"/>
            <argument type="service" id="HeyFrame\Core\Framework\Webhook\Hookable\WriteResultMerger"/>
            <argument type="service" id="HeyFrame\Core\Framework\Webhook\Hookable\HookableEventCollector"/>
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\Hookable\WriteResultMerger">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\BusinessEventEncoder">
            <argument type="service" id="HeyFrame\Core\Framework\Api\Serializer\JsonEntityEncoder"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\WebhookDefinition">
            <tag name="heyframe.entity.definition"/>

        </service>

        <service id="HeyFrame\Core\Framework\Webhook\EventLog\WebhookEventLogDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\Service\RelatedWebhooks">
            <argument type="service" id="Doctrine\DBAL\Connection" />
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\Hookable\HookableEventCollector">
            <argument type="service" id="HeyFrame\Core\Framework\Event\BusinessEventCollector"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="tagged_iterator" tag="heyframe.entity.hookable"/>
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\Handler\WebhookEventMessageHandler">
            <argument type="service" id="heyframe.app_system.guzzle"/>
            <argument type="service" id="webhook_event_log.repository"/>
            <argument type="service" id="HeyFrame\Core\Framework\Webhook\Service\RelatedWebhooks"/>

            <tag name="messenger.message_handler"/>
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\Subscriber\RetryWebhookMessageFailedSubscriber">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="HeyFrame\Core\Framework\Webhook\Service\RelatedWebhooks"/>

            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\Service\WebhookCleanup">
            <argument type="service" id="HeyFrame\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="Doctrine\DBAL\Connection" />
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\ScheduledTask\CleanupWebhookEventLogTask">
            <tag name="heyframe.scheduled.task" />
        </service>

        <service id="HeyFrame\Core\Framework\Webhook\ScheduledTask\CleanupWebhookEventLogTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="HeyFrame\Core\Framework\Webhook\Service\WebhookCleanup"/>
            <tag name="messenger.message_handler"/>
        </service>
    </services>
</container>
