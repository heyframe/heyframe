<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="HeyFrame\Core\Framework\Script\Execution\ScriptExecutor" public="true">
            <argument type="service" id="HeyFrame\Core\Framework\Script\Debugging\ScriptTraces"/>
            <argument type="service" id="service_container"/>
            <argument type="service" id="twig.extension.trans"/>
            <argument>%kernel.heyframe_version%</argument>
        </service>

        <service id="HeyFrame\Core\Framework\Script\ScriptDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Framework\Script\Debugging\ScriptTraces">
            <tag name="data_collector"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="HeyFrame\Core\Framework\Script\AppContextCreator">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
    </services>
</container>

