<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Core\Framework\Api\Acl\Admin\Role\AclRoleDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Framework\Api\Acl\Admin\Role\AclUserRoleDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Framework\Api\Acl\Admin\AclWriteValidator">
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Framework\Api\Acl\Admin\AclAnnotationValidator">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Framework\Api\Acl\Admin\AclCriteriaValidator" public="true">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
        </service>

        <service id="HeyFrame\Core\Framework\Api\EventListener\Acl\CreditOrderLineItemListener">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Framework\Api\Controller\AclController" public="true">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="event_dispatcher"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <argument type="service" id="router"/>
        </service>

       <service id="HeyFrame\Core\Framework\Api\Acl\Front\Role\CustomerRoleDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

       <service id="HeyFrame\Core\Framework\Api\Acl\Front\Role\CustomerRoleMappingDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Framework\Api\Acl\Front\AclAnnotationValidator">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.event_subscriber"/>
        </service>

    </services>
</container>
