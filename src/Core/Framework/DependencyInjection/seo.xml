<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Core\Content\Seo\SeoUrl\SeoUrlDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\SeoUrl\Channel\ChannelSeoUrlDefinition">
            <tag name="heyframe.channel.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\SeoUrlTemplate\SeoUrlTemplateDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\MainCategory\MainCategoryDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\MainCategory\Channel\ChannelMainCategoryDefinition">
            <tag name="heyframe.channel.entity.definition"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\SeoUrlGenerator">
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="router.default"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="heyframe.seo_url.twig"/>
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Twig\TwigVariableParserFactory"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\SeoUrlPersister">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="seo_url.repository"/>
            <argument type="service" id="event_dispatcher" />
        </service>

        <service id="HeyFrame\Core\Content\Seo\SeoUrlRoute\SeoUrlRouteRegistry" lazy="true">
            <argument type="tagged_iterator" tag="heyframe.seo_url.route"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\EmptyPathInfoResolver" public="true" decorates="HeyFrame\Core\Content\Seo\SeoResolver" decoration-priority="-2000">
            <argument type="service" id="HeyFrame\Core\Content\Seo\EmptyPathInfoResolver.inner"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\SeoResolver" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\Api\SeoActionController" public="true">
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlGenerator"/>
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlPersister"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlRoute\SeoUrlRouteRegistry"/>
            <argument type="service" id="HeyFrame\Core\Content\Seo\Validation\SeoUrlValidationFactory"/>
            <argument type="service" id="HeyFrame\Core\Framework\Validation\DataValidator"/>
            <argument type="service" id="channel.repository"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\Search\RequestCriteriaBuilder"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="HeyFrame\Core\Content\Seo\Validation\SeoUrlValidationFactory"/>

        <service id="HeyFrame\Core\Framework\Adapter\Twig\Extension\SeoUrlFunctionExtension">
            <argument type="service" id="twig.extension.routing"/>
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlPlaceholderHandlerInterface" />
            <tag name="twig.extension"/>
        </service>

        <service id="HeyFrame\Core\Framework\Adapter\Twig\Extension\TwigFeaturesWithInheritanceExtension">
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Twig\TemplateFinder"/>
            <tag name="twig.extension"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\SeoUrlPlaceholderHandlerInterface" class="HeyFrame\Core\Content\Seo\SeoUrlPlaceholderHandler" public="true">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="router.default"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyFrame\Core\Framework\Adapter\Twig\Extension\MediaExtension">
            <argument type="service" id="media.repository" />
            <tag name="twig.extension"/>
        </service>

        <service id="HeyFrame\Core\Framework\Adapter\Twig\Extension\RawUrlFunctionExtension">
            <argument type="service" id="router"/>
            <argument type="service" id="request_stack"/>
            <tag name="twig.extension"/>
        </service>

        <service id="HeyFrame\Core\Framework\Adapter\Twig\Extension\SwSanitizeTwigFilter" public="false">
            <argument type="service" id="HeyFrame\Core\Framework\Util\HtmlSanitizer"/>
            <tag name="twig.extension"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\HreflangLoaderInterface" class="HeyFrame\Core\Content\Seo\HreflangLoader">
            <argument type="service" id="router.default"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\Channel\SeoUrlRoute" public="true">
            <argument type="service" id="channel.seo_url.repository"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\Channel\StoreApiSeoResolver">
            <argument type="service" id="channel.seo_url.repository"/>
            <argument type="service" id="HeyFrame\Core\Framework\DataAbstractionLayer\DefinitionInstanceRegistry"/>
            <argument type="service" id="HeyFrame\Core\System\Channel\Entity\ChannelDefinitionInstanceRegistry"/>
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlRoute\SeoUrlRouteRegistry"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\SeoUrlUpdater">
            <argument type="service" id="language.repository"/>
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlRoute\SeoUrlRouteRegistry"/>
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlGenerator"/>
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlPersister"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="channel.repository"/>
        </service>

        <service id="HeyFrame\Core\Framework\Adapter\Twig\Extension\BuildBreadcrumbExtension">
            <argument type="service" id="HeyFrame\Core\Content\Navigation\Service\NavigationBreadcrumbBuilder"/>
            <argument type="service" id="channel.navigation.repository"/>
            <argument type="service" id="category.repository"/>
            <tag name="twig.extension"/>
        </service>

        <service id="HeyFrame\Core\Content\Seo\SeoUrlTwigFactory"/>

        <service id="heyframe.seo_url.twig" class="Twig\Environment">
            <factory service="HeyFrame\Core\Content\Seo\SeoUrlTwigFactory" method="createTwigEnvironment"/>
            <argument type="service" id="slugify"/>
            <argument type="tagged_iterator" tag="heyframe.seo_url.twig.extension"/>
            <argument>%kernel.cache_dir%</argument>
        </service>
    </services>
</container>
