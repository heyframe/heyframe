<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="HeyFrame\Core\Framework\Notification\NotificationBulkEntityExtension">
            <tag name="heyframe.bulk.entity.extension"/>
        </service>

        <service id="HeyFrame\Core\Framework\Notification\NotificationService" public="true">
            <argument type="service" id="notification.repository"/>
        </service>

        <service id="HeyFrame\Core\Framework\Notification\NotificationDefinition">
            <tag name="heyframe.entity.definition"/>
        </service>
    </services>
</container>
