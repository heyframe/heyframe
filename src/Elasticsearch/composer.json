{
    "name": "heyframe/elasticsearch",
    "description": "Elasticsearch for HeyFrame",
    "type": "library",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "HeyFrame\\Elasticsearch\\": ""
        },
        "exclude-from-classmap": [
            "/Test/"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "6.7.x-dev",
            "dev-trunk": "6.7.x-dev"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "ext-curl": "*",
        "async-aws/core": "^1.22",
        "doctrine/dbal": "^4.3.1",
        "monolog/monolog": "^3.3.1",
        "opensearch-project/opensearch-php": "^2.3.1",
        "heyframe/core": "*",
        "shyim/opensearch-php-dsl": "^1.0.5",
        "symfony/http-foundation": "~7.3.0",
        "symfony/messenger": "~7.3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.19"
    }
}
