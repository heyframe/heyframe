{# @sw-package framework #}
{% block base_doctype %}<!DOCTYPE html>{% endblock %}

{% block base_html %}
<html lang="{{ context.languageInfo.localeCode }}"
      itemscope="itemscope"
      itemtype="https://schema.org/WebPage">
{% endblock %}

{# Set variable to "true" to enable HMR (hot page reloading) mode #}
{% set isHMRMode = app.request.headers.get('hot-reload-mode') and app.environment == 'dev' %}

{% block base_head %}
    {% sw_include '@Frontend/frontend/layout/meta.html.twig' %}
{% endblock %}


{% block base_body %}
    <body class="{% block base_body_classes %}
        {%- if activeRoute is not empty -%}is-active-route-{{ activeRoute|replace({'.': '-'}) }}{%- endif -%}
    {%- endblock %}">


    {% block base_body_inner %}
        {% block base_esi_header %}
            {{ render_esi(path('frontend.header', { headerParameters: headerParameters }), { ignore_errors: false } ) }}
        {% endblock %}

        {% block base_main %}
            <main class="content-main" id="content-main">
                {% block base_main_inner %}
                    <div class="container">
                        {% block base_main_container %}
                            <div class="container-main">
                                {% block base_content %}{% endblock %}
                            </div>
                        {% endblock %}
                    </div>
                {% endblock %}
            </main>
        {% endblock %}

        {% block base_esi_footer %}
            {{ render_esi(path('frontend.footer', { footerParameters: footerParameters }), { ignore_errors: false } ) }}
        {% endblock %}

    {% endblock %}


    {% block base_body_script %}
    {% endblock %}
    </body>
{% endblock %}
</html>
