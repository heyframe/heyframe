{% block layout_header_navbar %}
    <div class="container">
        {% set navbarOptions = {
            pathIdList: heyframe.navigation.pathIdList
        } %}

        {% block layout_header_navbar_nav_element %}
            <nav class="navbar navbar-expand-lg main-navigation-menu"
                 id="main-navigation-menu"
            >
                <div class="collapse navbar-collapse" id="main_nav">
                    <ul class="navbar-nav main-navigation-menu-list flex-wrap">
                        {% set homeLabel = context.channel.translated.homeName|default('general.homeLink'|trans) %}
                        {% block layout_navbar_menu_home %}
                            {% if context.channel.translated.homeEnabled %}
                                <li class="nav-item nav-item-{{ context.channel.navigationId }}">
                                    <a class="nav-link main-navigation-link home-link root nav-item-{{ context.channel.navigationId }}-link"
                                       href="{{ path('frontend.home.page') }}"
                                       title="{{ homeLabel|striptags }}">
                                        <span class="main-navigation-link-text">{{ homeLabel|sw_sanitize }}</span>
                                    </a>
                                </li>
                            {% endif %}
                        {% endblock %}

                        {% block layout_navbar_menu_items %}
                            {% for treeItem in header.navigation.tree %}
                                {% set navigation = treeItem.navigation %}
                                {% set id = navigation.id %}
                                {% set name = navigation.translated.name %}
                                {% set hasChildren = treeItem.children|length > 0 %}
                                {% set itemSkipped = navigation.type == 'folder' and not hasChildren %}

                                {% block layout_navbar_menu_item %}
                                    {% if not itemSkipped %}
                                        <li class="nav-item nav-item-{{ id }} {% if hasChildren %}dropdown position-static{% endif %}">
                                            {% block layout_navbar_menu_item_link %}
                                                <a class="nav-link nav-item-{{ id }}-link root main-navigation-link p-2{% if hasChildren %} dropdown-toggle{% endif %}"
                                                   href="{{ navigation.seoUrl ?: '#' }}"
                                                   {% if hasChildren %}data-bs-toggle="dropdown"{% endif %}
                                                    {% if navigation.type != 'folder' and navigation.shouldOpenInNewTab %}target="_blank"{% endif %}
                                                   title="{{ name }}"
                                                >
                                                    {% block layout_navbar_menu_item_link_content %}
                                                        <span class="main-navigation-link-text">{{ name }}</span>
                                                    {% endblock %}
                                                </a>
                                            {% endblock %}

                                            {% if hasChildren %}
                                                {% block layout_navbar_menu_item_children %}
                                                    <div class="dropdown-menu w-100 p-4">
                                                        {% sw_include '@Frontend/frontend/layout/header/navbar/content.html.twig' with {
                                                            themeIconConfig: themeIconConfig,
                                                            navigationTree: treeItem,
                                                            level: level+1,
                                                            page: page
                                                        } only %}
                                                    </div>
                                                {% endblock %}
                                            {% endif %}
                                        </li>
                                    {% endif %}
                                {% endblock %}

                            {% endfor %}
                        {% endblock %}

                    </ul>
                </div>
            </nav>
        {% endblock %}
    </div>
{% endblock %}
