{% block layout_header %}
    {% block layout_top_bar %}
        {% sw_include '@Frontend/frontend/layout/header/top-bar.html.twig' %}
    {% endblock %}

    {% block layout_header_navigation %}
        <div class="row align-items-center header-row">
            {% block layout_header_logo %}
                <div class="col-12 col-lg-auto header-logo-col pb-sm-2 my-3">
                    {% sw_include '@Frontend/frontend/layout/header/logo.html.twig' %}
                </div>
            {% endblock %}

            {% block layout_header_navbar %}
                <div class="col-12 order-2 col-sm order-sm-1 header-navber-col">
                    <div class="row">
                        <div class="col">
                            {% sw_include '@Frontend/frontend/layout/header/navbar/navbar.html.twig' %}
                        </div>
                    </div>
                </div>
            {% endblock %}

            {% block layout_header_actions %}
                <div class="col-12 order-1 col-sm-auto order-sm-2 header-actions-col">
                    <div class="row g-0">
                        {% block layout_header_actions_account %}
                            <div class="col-auto">
                                <div class="account-menu">
                                    {% sw_include '@Frontend/frontend/layout/header/actions/account-widget.html.twig' %}
                                </div>
                            </div>
                        {% endblock %}
                    </div>
                </div>
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}
