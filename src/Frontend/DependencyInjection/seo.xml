<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Frontend\Framework\Seo\SeoUrlRoute\ProductPageSeoUrlRoute">
            <argument type="service" id="HeyFrame\Core\Content\Product\ProductDefinition"/>

            <tag name="shopware.seo_url.route"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Seo\SeoUrlRoute\NavigationPageSeoUrlRoute">
            <argument type="service" id="HeyFrame\Core\Content\Navigation\NavigationDefinition"/>
            <argument type="service" id="HeyFrame\Core\Content\Navigation\Service\NavigationBreadcrumbBuilder"/>

            <tag name="shopware.seo_url.route"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Seo\SeoUrlRoute\LandingPageSeoUrlRoute">
            <argument type="service" id="HeyFrame\Core\Content\LandingPage\LandingPageDefinition"/>

            <tag name="shopware.seo_url.route"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Seo\SeoUrlRoute\SeoUrlUpdateListener">
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlUpdater"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
