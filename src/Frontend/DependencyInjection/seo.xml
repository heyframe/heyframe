<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="HeyFrame\Frontend\Framework\Seo\SeoUrlRoute\SeoUrlUpdateListener">
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlUpdater"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.event_subscriber"/>
        </service>

         <service id="HeyFrame\Frontend\Framework\Seo\SeoUrlRoute\NavigationPageSeoUrlRoute">
            <argument type="service" id="HeyFrame\Core\Content\Category\CategoryDefinition"/>
            <argument type="service" id="HeyFrame\Core\Content\Category\Service\CategoryBreadcrumbBuilder"/>

            <tag name="heyframe.seo_url.route"/>
        </service>
    </services>
</container>
