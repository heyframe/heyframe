<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="HeyFrame\Frontend\Framework\Command\ChannelCreateFrontendCommand">
            <argument type="service" id="snippet_set.repository"/>
            <argument type="service" id="HeyFrame\Core\Maintenance\Channel\Service\ChannelCreator"/>

            <tag name="console.command"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Routing\FrontendRouteScope">
            <tag name="heyframe.route_scope"/>
        </service>
    </services>
</container>
