<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true"/>

        <service id="HeyFrame\Frontend\Framework\Command\ChannelCreateFrontendCommand">
            <argument type="service" id="snippet_set.repository"/>
            <argument type="service" id="HeyFrame\Core\Maintenance\Channel\Service\ChannelCreator"/>

            <tag name="console.command"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Routing\FrontendRouteScope">
            <tag name="heyframe.route_scope"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Twig\IconExtension">
            <tag name="twig.extension"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Twig\Extension\IconCacheTwigFilter" public="false">
            <tag name="twig.extension"/>
        </service>

        <service id="HeyFrame\Frontend\Theme\ThemeConfigValueAccessor">
            <argument type="service" id="HeyFrame\Frontend\Theme\ResolvedConfigLoader"/>
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Cache\CacheTagCollector"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Twig\TemplateDataExtension">
            <argument type="service" id="request_stack"/>
            <argument>%heyframe.staging.frontend.show_banner%</argument>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="twig.extension"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Twig\ThumbnailExtension">
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Twig\TemplateFinder"/>

            <tag name="twig.extension"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Twig\TemplateConfigAccessor">
            <argument type="service" id="HeyFrame\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="HeyFrame\Frontend\Theme\ThemeConfigValueAccessor"/>
            <argument type="service" id="HeyFrame\Frontend\Theme\ThemeScripts" />
            <argument type="service" id="HeyFrame\Frontend\Framework\Twig\Components\UxComponentRenderEventListener"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Routing\Router" decorates="router">
            <argument type="service" id="HeyFrame\Frontend\Framework\Routing\Router.inner"/>
            <argument type="service" id="request_stack"/>
            <argument>%frontend.router.allowed_routes%</argument>
        </service>

        <service id="HeyFrame\Frontend\Framework\Routing\ResponseHeaderListener">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Routing\DomainNotMappedListener">
            <argument type="service" id="service_container"/>

            <tag name="kernel.event_listener" event="kernel.exception"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Twig\Extension\ConfigExtension">
            <argument type="service" id="HeyFrame\Frontend\Framework\Twig\TemplateConfigAccessor"/>
            <tag name="twig.extension"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Routing\RequestTransformer"
                 decorates="HeyFrame\Core\Framework\Routing\RequestTransformerInterface" public="true">
            <argument type="service" id="HeyFrame\Frontend\Framework\Routing\RequestTransformer.inner"/>
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoResolver"/>
            <argument>%heyframe.routing.registered_api_prefixes%</argument>
            <argument type="service" id="HeyFrame\Frontend\Framework\Routing\DomainLoader"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Routing\CachedDomainLoaderInvalidator">
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Cache\CacheInvalidator"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Routing\CachedDomainLoader" decorates="HeyFrame\Frontend\Framework\Routing\DomainLoader" decoration-priority="-1000">
            <argument type="service" id="HeyFrame\Frontend\Framework\Routing\CachedDomainLoader.inner"/>
            <argument type="service" id="cache.object"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Routing\DomainLoader">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Twig\Components\UxComponentRenderEventListener">
            <tag name="kernel.event_listener" />
        </service>

        <service id="HeyFrame\Frontend\Framework\Twig\Components\UxComponentHelper">
            <argument>Resources/views/components/</argument>
            <argument>%kernel.project_dir%</argument>
            <argument>%kernel.bundles_metadata%</argument>
            <argument type="service" id="HeyFrame\Core\Framework\Adapter\Twig\NamespaceHierarchy\NamespaceHierarchyBuilder"/>
            <argument type="service" id="ux.twig_component.component_factory"/>
        </service>

       <service id="HeyFrame\Frontend\Page\GenericPageLoader">
            <argument type="service" id="HeyFrame\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="HeyFrame\Frontend\Page\Navigation\NavigationPageLoader">
            <argument type="service" id="HeyFrame\Frontend\Page\GenericPageLoader"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="HeyFrame\Core\Content\Navigation\Channel\LoadNavigationRoute"/>
            <argument type="service" id="HeyFrame\Core\Content\Seo\SeoUrlPlaceholderHandlerInterface"/>
        </service>

        <service id="HeyFrame\Frontend\Pagelet\Footer\FooterPageletLoader">
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="HeyFrame\Core\Content\Navigation\Service\NavigationLoader"/>
            <argument type="service" id="HeyFrame\Core\Checkout\Payment\Channel\PaymentMethodRoute"/>
        </service>

        <service id="HeyFrame\Frontend\Pagelet\Header\HeaderPageletLoader">
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="HeyFrame\Core\Content\Navigation\Service\NavigationLoader"/>
        </service>

        <service id="HeyFrame\Frontend\Framework\Twig\Extension\UrlEncodingTwigFilter" public="false">
            <tag name="twig.extension"/>
        </service>
    </services>
</container>
