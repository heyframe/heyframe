<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <defaults public="true" />

        <service id="HeyFrame\Frontend\Controller\NavigationController">
            <argument type="service" id="HeyFrame\Frontend\Page\Navigation\NavigationPageLoader"/>
            <argument type="service" id="HeyFrame\Frontend\Pagelet\Header\HeaderPageletLoader"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
